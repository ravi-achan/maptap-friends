<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Lionpack MapTap Table</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@112,600;112,800&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
:root{
  --bg:#eef2f0; --card:#fbfcfb; --ink:#13201b; --ink2:#4c5a54; --muted:#76837d; --line:#d6ddd9; --grid:#e3e8e5;
  --s1:#2a78d6; --s2:#eb6834; --s3:#1baf7a; --hi:#13201b; --chip:#e4ebe7;
  --good:#1f7a4a; --bad:#b93a32; --pos:#2a78d6; --neg:#e34948;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){color-scheme:dark;
    --bg:#0f1513; --card:#161e1b; --ink:#eef3f0; --ink2:#b7c3bd; --muted:#8a9791; --line:#2b3632; --grid:#222c28;
    --s1:#3987e5; --s2:#d95926; --s3:#199e70; --hi:#eef3f0; --chip:#222c28; --good:#5cc08a; --bad:#ef7b72; --pos:#3987e5; --neg:#e66767;}
}
:root[data-theme="dark"]{color-scheme:dark;
    --bg:#0f1513; --card:#161e1b; --ink:#eef3f0; --ink2:#b7c3bd; --muted:#8a9791; --line:#2b3632; --grid:#222c28;
    --s1:#3987e5; --s2:#d95926; --s3:#199e70; --hi:#eef3f0; --chip:#222c28; --good:#5cc08a; --bad:#ef7b72; --pos:#3987e5; --neg:#e66767;}
*{box-sizing:border-box} [hidden]{display:none!important}
body{background:var(--bg);color:var(--ink);font:15px/1.55 "IBM Plex Sans",system-ui,sans-serif;margin:0}
.wrap{max-width:1080px;margin:0 auto;padding-inline:20px;padding-block:32px 56px;display:grid;gap:28px}
.mono,.num{font-family:"IBM Plex Mono",ui-monospace,monospace;font-variant-numeric:tabular-nums}
h1,h2{font-family:"Archivo",system-ui,sans-serif;font-stretch:112%;margin:0;text-wrap:balance}
h1{font-weight:800;font-size:clamp(30px,6vw,52px);line-height:1;letter-spacing:-.01em}
h2{font-weight:600;font-size:20px}
.eyebrow{font:500 12px/1 "IBM Plex Mono",monospace;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
header{display:grid;gap:10px}
header p{margin:0;color:var(--ink2);max-width:68ch}
.panel{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:20px}
.sec{display:grid;gap:14px}
.sec-head{display:flex;justify-content:space-between;align-items:end;gap:12px;flex-wrap:wrap}
.sec-head p{margin:4px 0 0;color:var(--ink2);font-size:14px}
/* leaderboard */
.board{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
@media (max-width:820px){.board{grid-template-columns:1fr}}
.pl{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:18px;display:grid;gap:14px;border-top:4px solid var(--c)}
.pl-top{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
.pl-name{font:600 18px/1.2 "Archivo",sans-serif;font-stretch:112%;display:flex;align-items:center;gap:8px}
.rank{font:500 12px "IBM Plex Mono",monospace;color:var(--muted)}
.big{font:500 40px/1 "IBM Plex Mono",monospace;letter-spacing:-.02em}
.big small{font-size:14px;color:var(--muted);letter-spacing:0}
.kv{display:grid;grid-template-columns:1fr 1fr;gap:10px 14px}
.kv div{display:grid;gap:2px}
.kv dt{font-size:12px;color:var(--muted)}
.kv dd{margin:0;font:500 16px "IBM Plex Mono",monospace}
.kv dd .sub{font-size:12px;color:var(--muted);font-weight:400}
.up{color:var(--good)} .down{color:var(--bad)}
.dot{width:10px;height:10px;border-radius:50%;background:var(--c);display:inline-block;flex:none}
/* chart */
.seg{display:inline-flex;border:1px solid var(--line);border-radius:8px;overflow:hidden}
.seg button{font:500 13px "IBM Plex Sans",sans-serif;background:transparent;color:var(--ink2);border:0;padding:7px 12px;cursor:pointer}
.seg button[aria-pressed="true"]{background:var(--ink);color:var(--card)}
.seg button:focus-visible{outline:2px solid var(--s1);outline-offset:-2px}
.legend{display:flex;gap:16px;flex-wrap:wrap;font-size:13px;color:var(--ink2)}
.legend span{display:inline-flex;align-items:center;gap:6px}
.legend i{width:16px;height:3px;border-radius:2px;background:var(--c);display:inline-block}
.chart{position:relative;width:100%}
.chart svg{display:block;width:100%;height:auto;overflow:visible}
.chart text{fill:var(--muted);font:11px "IBM Plex Mono",monospace}
.tip{position:absolute;pointer-events:none;background:var(--card);border:1px solid var(--line);border-radius:8px;padding:8px 10px;font-size:13px;box-shadow:0 6px 20px rgba(0,0,0,.12);min-width:160px;display:grid;gap:3px}
.tip b{font-weight:600}
.tip .r{display:flex;justify-content:space-between;gap:14px;align-items:center}
.tip .r span:first-child{display:inline-flex;gap:6px;align-items:center}
.note{font-size:12.5px;color:var(--muted);margin:0}
.heat td.h{position:relative}
.heat td.h::before{content:"";position:absolute;inset:3px;border-radius:5px;background:var(--hc);opacity:var(--ha)}
.heat td.h>span{position:relative}
.heat .sm{font-size:11.5px;color:var(--muted);display:block}
.key{display:flex;gap:10px;align-items:center;font-size:12px;color:var(--muted);flex-wrap:wrap}
.key i{display:inline-block;width:60px;height:10px;border-radius:3px}
.places{display:grid;gap:10px;margin:0;padding:0;list-style:none}
.places li{display:grid;grid-template-columns:1fr auto;gap:4px 12px;padding-bottom:10px;border-bottom:1px solid var(--grid)}
.places li:last-child{border-bottom:0;padding-bottom:0}
.places .pn{font-weight:500}
.places .pd,.places .pw{font-size:12px;color:var(--muted)}
.places .ps{display:flex;gap:10px;font:500 13px "IBM Plex Mono",monospace;align-items:center;justify-content:end;flex-wrap:wrap}
.places .ps span{display:inline-flex;gap:4px;align-items:center}
.places .pw{grid-column:1/-1}
/* grids */
.two{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media (max-width:820px){.two{grid-template-columns:1fr}}
table{border-collapse:collapse;width:100%;font-size:14px}
th,td{padding:8px 10px;text-align:right;border-bottom:1px solid var(--grid)}
th:first-child,td:first-child{text-align:left}
thead th{font:500 11.5px "IBM Plex Mono",monospace;letter-spacing:.05em;text-transform:uppercase;color:var(--muted);font-weight:500}
td.num{font-size:13.5px}
.scroll{overflow-x:auto}
.h2h td.self{color:var(--muted);text-align:center}
.cellw{font-weight:600}
/* insights */
.ins{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
@media (max-width:820px){.ins{grid-template-columns:1fr}}
.ins article{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:16px 18px;display:grid;gap:6px;align-content:start}
.ins h3{margin:0;font:600 15.5px/1.35 "IBM Plex Sans",sans-serif}
.ins p{margin:0;color:var(--ink2);font-size:14px}
.ins .tag{font:500 11px "IBM Plex Mono",monospace;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
details{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:0}
summary{cursor:pointer;padding:14px 18px;font-weight:600}
details .scroll{padding:0 12px 12px}
.w{font-weight:600;color:var(--ink)}
.l{color:var(--muted)}
.rounds{color:var(--muted);font-size:11.5px;display:block}
.pill{display:inline-block;font:500 11px "IBM Plex Mono",monospace;padding:2px 7px;border-radius:99px;background:var(--chip);color:var(--ink2)}
.strip{display:grid;grid-template-columns:repeat(11,minmax(22px,1fr));gap:2px;min-width:260px}
.strip span{display:flex;align-items:center;justify-content:center;height:24px;border-radius:4px;font:500 11px "IBM Plex Mono",monospace;color:var(--ink);position:relative;overflow:hidden}
.strip span::before{content:"";position:absolute;inset:0;background:var(--sc);opacity:var(--sa)}
.strip span b{position:relative;font-weight:500}
.strip.hdr span{height:auto;color:var(--muted);font-size:10px}
.rh td{vertical-align:middle}
.rh td.pair{white-space:nowrap}
.wl{display:flex;gap:16px;flex-wrap:wrap}
.wl div{display:grid;gap:2px;min-width:110px}
.wl b{font:500 22px "IBM Plex Mono",monospace}
.wl span{font-size:12px;color:var(--muted)}
.dist100{display:grid;gap:10px}
.dbar{display:grid;grid-template-columns:110px 1fr;gap:10px;align-items:center}
.dbar .nm{font-size:13.5px;display:flex;gap:6px;align-items:center}
.dbar .bar{display:flex;height:26px;border-radius:5px;overflow:hidden;gap:2px;background:var(--card)}
.dbar .bar span{display:flex;align-items:center;justify-content:center;font:500 10.5px "IBM Plex Mono",monospace;color:#fff;min-width:0;overflow:hidden;white-space:nowrap}
.dbar .bar span.lt{color:var(--ink)}
.bkey{display:flex;gap:12px;flex-wrap:wrap;font-size:12px;color:var(--muted)}
.bkey i{display:inline-block;width:12px;height:12px;border-radius:3px;vertical-align:-2px;margin-right:4px}
:root{--b1:#0d366b;--b2:#256abf;--b3:#6da7ec;--b4:#b7d3f6;--b5:#c9c8c2;--b6:#f0a3a2;--b7:#d93b3a}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--b1:#9ec5f4;--b2:#5598e7;--b3:#2a78d6;--b4:#184f95;--b5:#55554f;--b6:#8e3a39;--b7:#e66767}}
:root[data-theme="dark"]{--b1:#9ec5f4;--b2:#5598e7;--b3:#2a78d6;--b4:#184f95;--b5:#55554f;--b6:#8e3a39;--b7:#e66767}
.otgrid{display:grid;gap:18px}
.otchart{position:relative;width:100%}
.otchart svg{display:block;width:100%;height:auto;overflow:visible}
.otchart text{fill:var(--muted);font:11px "IBM Plex Mono",monospace}
.otchart .ttl{fill:var(--ink);font:600 13px "IBM Plex Sans",sans-serif}
.sub-h{margin:0;font:600 15px "IBM Plex Sans",sans-serif}
.cal-key{display:flex;gap:14px;flex-wrap:wrap;font-size:12px;color:var(--muted);align-items:center}
.cal-key i{display:inline-block;width:12px;height:12px;border-radius:3px;vertical-align:-2px;margin-right:5px}
</style>

<div class="wrap">
  <header>
    <div class="eyebrow">Lionpack group chat · 24 Jul – 29 Oct 2026 · 98 daily maps</div>
    <h1>Lionpack MapTap Table</h1>
    <p>Every daily <span class="mono">maptap.gg</span> result posted in the chat, scored out of 1,000 across five rounds. Where someone posted twice for the same day, only their first post counts; the second was a forwarded score from a partner or family member.</p>
    <p class="note">Locations come from MapTap’s daily history pages, via a public mirror, with gaps filled in from maptap.gg. World averages are MapTap’s own per-round player data.</p>
  </header>

  <section class="sec">
    <div class="sec-head"><div><h2>Standings</h2><p>Ranked by all-time average. Rolling windows are calendar days ending 29 Oct, averaging the games played in that window.</p></div></div>
    <div class="board" id="board"></div>
  </section>

  <section class="sec panel">
    <div class="sec-head">
      <div><h2 id="chartTitle">Rolling 7-day average</h2><p id="chartSub">Average of each player's scores over the previous 7 days, plotted daily.</p></div>
      <div class="seg" role="group" aria-label="Chart view">
        <button type="button" id="b7" aria-pressed="true">7-day</button>
        <button type="button" id="b30" aria-pressed="false">30-day</button>
        <button type="button" id="braw" aria-pressed="false">Daily</button>
        <button type="button" id="bvw" aria-pressed="false">vs world</button>
      </div>
    </div>
    <div class="legend" id="legend"></div>
    <div class="chart" id="chart"></div>
    <p class="note">Rahul's line starts on 25 Jul, his first game.</p>
  </section>

  <section class="sec">
    <div class="sec-head"><div><h2>What stands out</h2></div></div>
    <div class="ins" id="ins"></div>
  </section>

  <section class="sec">
    <div class="sec-head"><div><h2>Geography</h2><p>Every round matched to the place MapTap asked for: 485 map rounds, 451 different places, 1,260 scores. “vs world” is points per round above MapTap’s global average for that exact round, so it adjusts for how hard each place was.</p></div></div>
    <div class="ins" id="geoins"></div>
  </section>

  <section class="panel sec">
    <div class="sec-head"><div><h2>By continent</h2><p>Average round score, with points above or below the world average underneath.</p></div>
      <div class="key"><span>below world</span><i style="background:linear-gradient(90deg,var(--neg),var(--card),var(--pos))"></i><span>above world</span></div></div>
    <div class="scroll"><table class="heat" id="conttab"></table></div>
  </section>

  <section class="panel sec">
    <div class="sec-head"><div><h2>By region</h2><p>Sorted hardest first, by the world average. Map-round counts are for the whole group.</p></div></div>
    <div class="scroll"><table class="heat" id="regtab"></table></div>
  </section>

  <section class="two">
    <div class="panel sec">
      <div><h2>Rounds that decided days</h2><p class="note" style="margin-top:4px">Biggest gaps between the three of you on a single round.</p></div>
      <ul class="places" id="splits"></ul>
    </div>
    <div class="panel sec">
      <div><h2>Hardest for the group</h2><p class="note" style="margin-top:4px">Lowest three-way average on a single round.</p></div>
      <ul class="places" id="hardest"></ul>
    </div>
  </section>

  <section class="panel sec" id="overtime">
    <div class="sec-head"><div><h2>Over time</h2><p>How the season has moved week by week: where whitewashes happened, how spread out each player's week was, who won each day, and the days that split the group.</p></div></div>

    <div class="sec"><h3 class="sub-h">Whitewash watch</h3>
      <p class="note">One row per player. Each box covers that week's round margins against every opponent, from −5 (whitewashed) to +5 (whitewash). The box is the middle half, the line is the median and the whiskers show the range. ▲ marks a 5–0 dealt and ▼ a 5–0 suffered, with the count beside it when there's more than one.</p>
      <div class="otchart" id="wwbox"></div></div>

    <div class="sec"><h3 class="sub-h">Weekly score boxplots</h3>
      <p class="note">Daily totals per week, side by side for each player. Taller boxes mean a more up-and-down week, and dots are outliers.</p>
      <div class="legend" id="otlegend"></div>
      <div class="otchart" id="wkbox"></div></div>

    <div class="two">
      <div class="sec"><h3 class="sub-h">Who won each day</h3>
        <p class="note">Weeks run left to right and days top to bottom (Mon–Sun). The colour is the day's winner, and stronger colour means a bigger winning margin. Hover a cell for the scores.</p>
        <div class="cal-key" id="calkey"></div>
        <div class="otchart" id="cal"></div></div>
      <div class="sec"><h3 class="sub-h">Every daily score</h3>
        <p class="note">Each dot is one day's total. The thin line is the player's median.</p>
        <div class="otchart" id="swarm"></div></div>
    </div>

    <div class="sec"><h3 class="sub-h">Chaos index</h3>
      <p class="note">Gap between the best and worst regular each day, on days at least three played. Tall bars are the maps that split the group, and short bars the days everyone landed together.</p>
      <div class="otchart" id="chaos"></div></div>

    <div class="ins" id="otins"></div>
  </section>

  <section class="panel sec" id="roundsdist">
    <div class="sec-head"><div><h2>Round scores</h2><p>Every individual round score, out of 100, pooled per player. The bar shows how each player's rounds are spread. The table gives averages and how much they vary.</p></div>
      <div class="bkey" id="bkey"></div></div>
    <div class="dist100" id="distbars"></div>
    <div class="scroll"><table id="disttab"></table></div>
    <p class="note">Variance is the square of the standard deviation (SD), so it punishes big misses hardest. “Points lost to bad rounds” is the share of all the points you've dropped below 100 that came from rounds under 70.</p>
    <div class="ins" id="distins"></div>
  </section>

  <section class="panel sec" id="character">
    <div class="sec-head"><div><h2>Form and character</h2><p>Elo ratings treat every day as a head-to-head against everyone who played, like chess. Everyone starts at 1500, and a win against a stronger player is worth more. Below it: how you react to a bad day, whether good days run in streaks, and the group's best-ball “dream team”.</p></div></div>
    <div class="legend" id="elolegend"></div>
    <div class="chart" id="elochart"></div>
    <div class="scroll"><table id="chartab"></table></div>
    <p class="note">A bad day is one more than one SD below your average, and a good day one more than one SD above. Day-to-day correlation near 0 means yesterday tells you nothing about today. Positive means streaky, negative means you bounce back. The dream team takes the best score of whoever played on each round.</p>
    <div class="ins" id="charins"></div>
  </section>

  <section class="panel sec" id="rounds">
    <div class="sec-head"><div><h2>Round by round</h2><p>Every shared day treated as a five-round match: you win a round by scoring higher on that location, and equal scores are a tie. A 5–0 whitewash means one player beat the other on every single round.</p></div></div>
    <div class="wl" id="washboard"></div>
    <div class="scroll"><table class="rh" id="rhtab"></table></div>
    <p class="note">The strip shows how each pair's matches finished, from the left player's view: round margin −5 (whitewashed) through 0 (level) to +5 (whitewash). Ties within a match are why some margins are odd-looking, e.g. 3–1 with one tied round is +2. “Won the day, lost the rounds” counts days where a player had the higher total despite winning fewer rounds.</p>
    <div class="ins" id="rhins"></div>
  </section>

  <section class="two">
    <div class="panel sec">
      <div><h2>Head to head</h2><p class="note" style="margin-top:4px">Row player's wins against column player, on days both played.</p></div>
      <div class="scroll"><table class="h2h" id="h2h"></table></div>
    </div>
    <div class="panel sec">
      <div><h2>Average by round</h2><p class="note" style="margin-top:4px">Each round is worth 100. Later rounds are harder for everyone.</p></div>
      <div class="chart" id="rchart"></div>
    </div>
  </section>

  <section class="panel sec">
    <div><h2>More numbers</h2></div>
    <div class="scroll"><table id="more"></table></div>
  </section>

  <section class="two">
    <div class="panel sec">
      <div><h2>Themed maps</h2><p class="note" style="margin-top:4px">Custom MapTap maps played on 31 Jul and 5 Aug. Not included in the daily stats.</p></div>
      <div class="scroll"><table id="themed"></table></div>
    </div>
    <div class="panel sec">
      <div><h2>Forwarded scores</h2><p class="note" style="margin-top:4px">Second posts and labelled posts, left out of every figure above.</p></div>
      <div class="scroll"><table id="guests"></table></div>
    </div>
  </section>

  <details>
    <summary>Full daily log (98 days)</summary>
    <div class="scroll"><table id="log"></table></div>
  </details>
