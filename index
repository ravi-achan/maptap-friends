 ["Weekly form", "Ravi and Rahul both up this week", "Ravi's weekly median went from 907 last week to 922. Rahul's went from 876 to 913. Kevan's is 883, from two games."],
 ["Mondays", "Ravi's Monday problem", "Ravi averages 889 on Mondays and 911–931 on every other day."],
];
/* over time */
(function(){
  const days=D.days, short=p=>SHORT[p]||p;
  const L=LOG;
  const wkOf=d=>{const t=new Date(d+"T12:00:00Z");const wd=(t.getUTCDay()+6)%7;t.setUTCDate(t.getUTCDate()-wd);return t.toISOString().slice(0,10);};
  const weeks=[...new Set(days.map(wkOf))];
  const q=(a,p)=>{const s=[...a].sort((x,y)=>x-y);const i=(s.length-1)*p,lo=Math.floor(i),hi=Math.ceil(i);return s[lo]+(s[hi]-s[lo])*(i-lo);};
  const box=a=>{const q1=q(a,.25),q3=q(a,.75),iqr=q3-q1,lo=Math.min(...a.filter(v=>v>=q1-1.5*iqr)),hi=Math.max(...a.filter(v=>v<=q3+1.5*iqr));return {q1,med:q(a,.5),q3,lo,hi,out:a.filter(v=>v<lo||v>hi)};};
  const tipOn=(boxEl)=>{const t=document.createElement("div");t.className="tip";t.hidden=true;boxEl.appendChild(t);return t;};
  const wlab=w=>{const t=new Date(w+"T12:00:00Z");return t.toLocaleDateString("en-GB",{day:"numeric",month:"short",timeZone:"UTC"});};
  function hoverify(el,tip){el.querySelectorAll("[data-tip]").forEach(n=>{n.style.cursor="default";n.addEventListener("pointerenter",ev=>{tip.innerHTML=n.getAttribute("data-tip");tip.hidden=false;});n.addEventListener("pointermove",ev=>{const r=el.getBoundingClientRect();const x=ev.clientX-r.left,y=ev.clientY-r.top;const tw=tip.offsetWidth;tip.style.left=(x+14+tw>r.width?x-14-tw:x+14)+"px";tip.style.top=Math.max(0,y-10)+"px";});n.addEventListener("pointerleave",()=>tip.hidden=true);});}
  // margins per player per week
  const mg={},wwd={},wws={};
  P.forEach(p=>{mg[p]={};wwd[p]={};wws[p]={};weeks.forEach(w=>{mg[p][w]=[];wwd[p][w]=0;wws[p][w]=0;});});
  days.forEach(d=>{const e=L[d]||{};const pl=P.filter(p=>e[p]);pl.forEach(a=>pl.forEach(b=>{if(a===b)return;let w=0,l=0;for(let i=0;i<5;i++){if(e[a][1][i]>e[b][1][i])w++;else if(e[a][1][i]<e[b][1][i])l++;}const wk=wkOf(d);mg[a][wk].push(w-l);if(w===5)wwd[a][wk]++;if(l===5)wws[a][wk]++;}));});
  function drawWW(){
    const el=document.getElementById("wwbox");const W=el.clientWidth||900,rowH=118,m={l:96,r:16,t:8,b:26},iw=W-m.l-m.r,H=m.t+rowH*P.length+m.b,n=weeks.length,bw=Math.min(26,iw/n*0.5);
    const x=i=>m.l+iw*(i+0.5)/n;let s="";
    P.forEach((p,pi)=>{const top=m.t+pi*rowH,ih=rowH-26,y=v=>top+10+ih*(1-(v+5)/10);
      s+=`<text class="ttl" x="${m.l-12}" y="${top+10+ih/2+4}" text-anchor="end" style="fill:var(--ink)">${short(p)}</text>`;
      [-5,0,5].forEach(v=>s+=`<line x1="${m.l}" x2="${m.l+iw}" y1="${y(v)}" y2="${y(v)}" stroke="${v===0?"var(--muted)":"var(--grid)"}" ${v===0?'stroke-dasharray="3 3"':''}/><text x="${m.l-4}" y="${y(v)+4}" text-anchor="end" style="font-size:10px">${v>0?"+"+v:v}</text>`);
      weeks.forEach((w,i)=>{const a=mg[p][w];if(!a.length)return;const b=box(a);const cx=x(i);
        const tip=`<b>${short(p)} · week of ${wlab(w)}</b><div>${a.length} matches · median ${b.med>0?"+":""}${b.med}</div><div>5–0s dealt ${wwd[p][w]} · suffered ${wws[p][w]}</div>`;
        s+=`<g data-tip="${tip.replace(/"/g,"&quot;")}"><rect x="${cx-bw/2-4}" y="${top}" width="${bw+8}" height="${ih+20}" fill="transparent"/>
          <line x1="${cx}" x2="${cx}" y1="${y(b.lo)}" y2="${y(b.hi)}" stroke="${COL[p]}" stroke-width="1.5"/>
          <rect x="${cx-bw/2}" y="${y(b.q3)}" width="${bw}" height="${Math.max(2,y(b.q1)-y(b.q3))}" rx="3" fill="${COL[p]}" fill-opacity=".28" stroke="${COL[p]}" stroke-width="1.5"/>
          <line x1="${cx-bw/2}" x2="${cx+bw/2}" y1="${y(b.med)}" y2="${y(b.med)}" stroke="${COL[p]}" stroke-width="2.5"/>
          ${b.out.map(v=>`<circle cx="${cx}" cy="${y(v)}" r="2.5" fill="${COL[p]}"/>`).join("")}</g>`;
        if(wwd[p][w]) s+=`<text x="${cx}" y="${y(5)-3}" text-anchor="middle" style="fill:${COL[p]};font-size:13px">▲</text>${wwd[p][w]>1?`<text x="${cx+8}" y="${y(5)-4}" style="fill:var(--ink);font-size:10px">${wwd[p][w]}</text>`:""}`;
        if(wws[p][w]) s+=`<text x="${cx}" y="${y(-5)+13}" text-anchor="middle" style="fill:var(--bad);font-size:13px">▼</text>${wws[p][w]>1?`<text x="${cx+8}" y="${y(-5)+12}" style="fill:var(--ink);font-size:10px">${wws[p][w]}</text>`:""}`;
      });});
    weeks.forEach((w,i)=>{if(i%2===0||n<10) s+=`<text x="${x(i)}" y="${H-6}" text-anchor="middle">${wlab(w)}</text>`;});
    el.innerHTML=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Weekly round-margin boxplots with whitewashes">${s}</svg>`;hoverify(el,tipOn(el));
  }
  function drawWK(){
    const el=document.getElementById("wkbox");const W=el.clientWidth||900,H=Math.max(260,Math.min(360,W*0.38)),m={l:44,r:12,t:10,b:26},iw=W-m.l-m.r,ih=H-m.t-m.b,n=weeks.length;
    const all=Object.values(L).flatMap(e=>P.filter(p=>e[p]).map(p=>e[p][0]));const lo=Math.floor(Math.min(...all)/50)*50,hi=1000;
    const y=v=>m.t+ih*(1-(v-lo)/(hi-lo)),slot=iw/n,bw=Math.max(4,Math.min(16,slot*0.8/P.length-3));let s="";
    for(let v=lo;v<=hi;v+=50) s+=`<line x1="${m.l}" x2="${m.l+iw}" y1="${y(v)}" y2="${y(v)}" stroke="var(--grid)"/><text x="${m.l-6}" y="${y(v)+4}" text-anchor="end">${v}</text>`;
    weeks.forEach((w,i)=>{const c0=m.l+slot*i+slot/2,act=P.filter(p=>days.some(d=>wkOf(d)===w&&L[d]&&L[d][p]));
      act.forEach((p,j)=>{const a=days.filter(d=>wkOf(d)===w&&L[d]&&L[d][p]).map(d=>L[d][p][0]);const b=box(a);const cx=c0+(j-(act.length-1)/2)*(bw+3);
        const tip=`<b>${short(p)} · week of ${wlab(w)}</b><div>${a.length} games · median ${Math.round(b.med)}</div><div>range ${Math.min(...a)}–${Math.max(...a)}</div>`;
        s+=`<g data-tip="${tip}"><rect x="${cx-bw/2-1}" y="${m.t}" width="${bw+2}" height="${ih}" fill="transparent"/><line x1="${cx}" x2="${cx}" y1="${y(b.lo)}" y2="${y(b.hi)}" stroke="${COL[p]}" stroke-width="1.2"/>
          <rect x="${cx-bw/2}" y="${y(b.q3)}" width="${bw}" height="${Math.max(2,y(b.q1)-y(b.q3))}" rx="2" fill="${COL[p]}" fill-opacity=".3" stroke="${COL[p]}" stroke-width="1.2"/>
          <line x1="${cx-bw/2}" x2="${cx+bw/2}" y1="${y(b.med)}" y2="${y(b.med)}" stroke="${COL[p]}" stroke-width="2.2"/>${b.out.map(v=>`<circle cx="${cx}" cy="${y(v)}" r="2.3" fill="${COL[p]}"/>`).join("")}</g>`;});
      if(i%2===0||n<10) s+=`<text x="${c0}" y="${H-6}" text-anchor="middle">${wlab(w)}</text>`;});
    el.innerHTML=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Weekly boxplots of daily scores">${s}</svg>`;hoverify(el,tipOn(el));
  }
  function drawCal(){
    const el=document.getElementById("cal");const W=el.clientWidth||460,n=weeks.length,m={l:30,r:4,t:4,b:22},cs=Math.min(30,(W-m.l-m.r)/n-3),H=m.t+7*(cs+3)+m.b;let s="";
    ["M","T","W","T","F","S","S"].forEach((d,i)=>s+=`<text x="${m.l-8}" y="${m.t+i*(cs+3)+cs/2+4}" text-anchor="end">${d}</text>`);
    days.forEach(d=>{const w=weeks.indexOf(wkOf(d)),wd=(new Date(d+"T12:00:00Z").getUTCDay()+6)%7,e=L[d]||{},pl=P.filter(p=>e[p]);const xx=m.l+w*(cs+3),yy=m.t+wd*(cs+3);
      if(pl.length<2){s+=`<rect x="${xx}" y="${yy}" width="${cs}" height="${cs}" rx="4" fill="none" stroke="var(--grid)"/>`;return;}
      const sc=pl.map(p=>[p,e[p][0]]).sort((a,b)=>b[1]-a[1]);const winners=sc.filter(x=>x[1]===sc[0][1]).map(x=>x[0]);const marg=sc[0][1]-sc[1][1];const op=winners.length>1?0.35:(0.3+0.7*Math.min(1,marg/80));
      const fill=winners.length>1?"var(--muted)":COL[winners[0]];
      const tip=`<b>${fmtDW(d)}</b>`+sc.map(([p,v])=>`<div class="r"><span><span class="dot" style="--c:${COL[p]}"></span>${short(p)}</span><span class="mono">${v}</span></div>`).join("");
      s+=`<rect data-tip="${tip.replace(/"/g,"&quot;")}" x="${xx}" y="${yy}" width="${cs}" height="${cs}" rx="4" fill="${fill}" fill-opacity="${op.toFixed(2)}"/>`;});
    weeks.forEach((w,i)=>{if(i%3===0) s+=`<text x="${m.l+i*(cs+3)}" y="${H-6}">${wlab(w)}</text>`;});
    el.innerHTML=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Calendar of daily winners">${s}</svg>`;hoverify(el,tipOn(el));
    document.getElementById("calkey").innerHTML=P.map(p=>`<span><i style="background:${COL[p]}"></i>${short(p)}</span>`).join("")+`<span><i style="background:var(--muted);opacity:.4"></i>tie</span><span><i style="border:1px solid var(--grid)"></i>&lt;2 played</span>`;
  }
  function drawSwarm(){
    const el=document.getElementById("swarm");const W=el.clientWidth||460,rowH=Math.max(64,Math.round(260/P.length)),m={l:70,r:10,t:6,b:24},iw=W-m.l-m.r,H=m.t+rowH*P.length+m.b;
    const all=Object.values(L).flatMap(e=>P.filter(p=>e[p]).map(p=>e[p][0]));const lo=Math.floor(Math.min(...all)/50)*50,hi=1000,x=v=>m.l+iw*(v-lo)/(hi-lo);let s="";
    for(let v=lo;v<=hi;v+=50) s+=`<line x1="${x(v)}" x2="${x(v)}" y1="${m.t}" y2="${H-m.b}" stroke="var(--grid)"/>${(v-lo)%100===0?`<text x="${x(v)}" y="${H-6}" text-anchor="middle">${v}</text>`:""}`;
    P.forEach((p,pi)=>{const cy=m.t+pi*rowH+rowH/2;const pts=days.filter(d=>L[d]&&L[d][p]).map(d=>[L[d][p][0],d]).sort((a,b)=>a[0]-b[0]);const placed=[];const r=2.7;
      s+=`<text x="${m.l-8}" y="${cy+4}" text-anchor="end" style="fill:var(--ink);font-family:'IBM Plex Sans';font-size:12.5px">${short(p)}</text>`;
      pts.forEach(([v,d])=>{const px=x(v);let off=0,k=0;while(placed.some(([qx,qy])=>Math.hypot(qx-px,qy-(cy+off))<2*r+0.6)){k++;off=(k%2?1:-1)*Math.ceil(k/2)*(2*r*0.85);if(Math.abs(off)>rowH/2-4)break;}placed.push([px,cy+off]);
        s+=`<circle data-tip="<b>${short(p)}</b><div>${fmtDW(d)} · ${v}</div>" cx="${px}" cy="${cy+off}" r="${r}" fill="${COL[p]}" fill-opacity=".8"/>`;});
      const med=q(pts.map(z=>z[0]),.5);s+=`<line x1="${x(med)}" x2="${x(med)}" y1="${cy-rowH/2+4}" y2="${cy+rowH/2-4}" stroke="var(--ink)" stroke-width="1.5"/>`;});
    el.innerHTML=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Every daily score per player">${s}</svg>`;hoverify(el,tipOn(el));
  }
  function drawChaos(){
    const el=document.getElementById("chaos");const W=el.clientWidth||900,H=200,m={l:40,r:10,t:16,b:24},iw=W-m.l-m.r,ih=H-m.t-m.b,n=days.length;
    const sp=days.map(d=>{const e=L[d]||{},pl=P.filter(p=>e[p]);if(pl.length<3)return null;const v=pl.map(p=>e[p][0]);return {d,s:Math.max(...v)-Math.min(...v),e,pl};});
    const mx=Math.ceil(Math.max(...sp.filter(Boolean).map(z=>z.s))/50)*50,y=v=>m.t+ih*(1-v/mx),bw=Math.max(2,iw/n-2);let s="";
    for(let v=0;v<=mx;v+=100) s+=`<line x1="${m.l}" x2="${m.l+iw}" y1="${y(v)}" y2="${y(v)}" stroke="var(--grid)"/><text x="${m.l-6}" y="${y(v)+4}" text-anchor="end">${v}</text>`;
    const top=sp.filter(Boolean).sort((a,b)=>b.s-a.s).slice(0,3).map(z=>z.d);
    sp.forEach((z,i)=>{if(!z)return;const xx=m.l+iw*i/n;const tip=`<b>${fmtDW(z.d)} · spread ${z.s}</b>`+z.pl.map(p=>[p,z.e[p][0]]).sort((a,b)=>b[1]-a[1]).map(([p,v])=>`<div class="r"><span><span class="dot" style="--c:${COL[p]}"></span>${short(p)}</span><span class="mono">${v}</span></div>`).join("");
      s+=`<rect data-tip="${tip.replace(/"/g,"&quot;")}" x="${xx}" y="${y(z.s)}" width="${bw}" height="${m.t+ih-y(z.s)}" rx="2" fill="${top.includes(z.d)?"var(--ink)":"var(--muted)"}" fill-opacity="${top.includes(z.d)?0.85:0.45}"/>`;
      if(top.includes(z.d)) s+=`<text x="${xx+bw/2}" y="${y(z.s)-4}" text-anchor="middle" style="fill:var(--ink)">${fmtD(z.d)}</text>`;});
    days.forEach((d,i)=>{if(d.endsWith("-01")) s+=`<text x="${m.l+iw*i/n}" y="${H-6}">${fmtD(d)}</text>`;});
    el.innerHTML=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Daily score spread">${s}</svg>`;hoverify(el,tipOn(el));
  }
  document.getElementById("otlegend").innerHTML=P.map(p=>`<span style="--c:${COL[p]}"><i></i>${short(p)}</span>`).join("");
  const all=()=>{drawWW();drawWK();drawCal();drawSwarm();drawChaos();};all();
  let rt2;addEventListener("resize",()=>{clearTimeout(rt2);rt2=setTimeout(all,150);});
  document.getElementById("otins").innerHTML=OTINS.map(([t,h,p])=>`<article><span class="tag">${t}</span><h3>${h}</h3><p>${p}</p></article>`).join("");
})();
