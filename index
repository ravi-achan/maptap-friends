function drawLine(){
  const W=chartBox.clientWidth||900, H=Math.max(260,Math.min(380,W*0.42));
  const m={l:40,r:52,t:12,b:26}, iw=W-m.l-m.r, ih=H-m.t-m.b;
  const days=D.days, n=days.length;
  const vals=P.flatMap(p=>D.players[p][mode]).filter(v=>v!=null);
  let lo=Math.floor((Math.min(...vals)-5)/25)*25, hi=Math.ceil((Math.max(...vals)+5)/25)*25;
  if(mode==="raw"){lo=Math.floor(Math.min(...vals)/50)*50; hi=1000;}
  if(mode==="vw"){lo=Math.min(-5,Math.floor(Math.min(...vals)/5)*5); hi=Math.ceil(Math.max(...vals)/5)*5;}
  const x=i=>m.l+iw*i/(n-1), y=v=>m.t+ih*(1-(v-lo)/(hi-lo));
  const step = mode==="vw"?5:((hi-lo)>200?50:25);
  let g="";
  for(let v=lo; v<=hi; v+=step){ g+=`<line x1="${m.l}" x2="${m.l+iw}" y1="${y(v)}" y2="${y(v)}" stroke="${mode==="vw"&&v===0?"var(--muted)":"var(--grid)"}" stroke-width="1"/><text x="${m.l-6}" y="${y(v)+4}" text-anchor="end">${mode==="vw"&&v>0?"+"+v:v}</text>`; }
  days.forEach((d,i)=>{ if(d.endsWith("-01")||i===0){ g+=`<line x1="${x(i)}" x2="${x(i)}" y1="${m.t}" y2="${m.t+ih}" stroke="var(--grid)"/><text x="${x(i)+4}" y="${H-8}">${fmtD(d)}</text>`; }});
  let lines="", ends="";
  const endLabels=[];
  P.forEach(p=>{
    const a=D.players[p][mode];
    if(mode==="raw"){
      a.forEach((v,i)=>{ if(v!=null) lines+=`<circle cx="${x(i)}" cy="${y(v)}" r="3.2" fill="${COL[p]}" stroke="var(--card)" stroke-width="1.5"/>`; });
    } else {
      let dstr="",pen=false;
      a.forEach((v,i)=>{ if(v==null){pen=false;return;} dstr+=(pen?"L":"M")+x(i).toFixed(1)+","+y(v).toFixed(1); pen=true; });
      lines+=`<path d="${dstr}" fill="none" stroke="${COL[p]}" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round"/>`;
      let li=a.length-1; while(a[li]==null) li--;
      ends+=`<circle cx="${x(li)}" cy="${y(a[li])}" r="4" fill="${COL[p]}" stroke="var(--card)" stroke-width="2"/>`;
      endLabels.push({p,y:y(a[li]),v:a[li],x:x(li)});
    }
  });
  endLabels.sort((a,b)=>a.y-b.y); for(let i=1;i<endLabels.length;i++){ if(endLabels[i].y-endLabels[i-1].y<14) endLabels[i].y=endLabels[i-1].y+14; }
  endLabels.forEach(e=>{ ends+=`<text x="${m.l+iw+8}" y="${e.y+4}" style="fill:var(--ink);font-weight:500">${mode==="vw"?(e.v>0?"+":"")+e.v.toFixed(1):Math.round(e.v)}</text>`; });
  chartBox.innerHTML=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${mode} scores over time">${g}${lines}${ends}<line id="xh" x1="0" x2="0" y1="${m.t}" y2="${m.t+ih}" stroke="var(--muted)" stroke-dasharray="3 3" opacity="0"/><rect x="${m.l}" y="${m.t}" width="${iw}" height="${ih}" fill="transparent" id="hit"/></svg><div class="tip" hidden></div>`;
  const svg=chartBox.querySelector("svg"), tip=chartBox.querySelector(".tip"), xh=svg.querySelector("#xh");
  const move=ev=>{
    const r=svg.getBoundingClientRect(); const sx=(ev.clientX-r.left)*W/r.width;
    const i=Math.max(0,Math.min(n-1,Math.round((sx-m.l)/iw*(n-1))));
    xh.setAttribute("x1",x(i)); xh.setAttribute("x2",x(i)); xh.setAttribute("opacity",1);
    const rowsH=P.map(p=>[p,D.players[p][mode][i]]).sort((a,b)=>(b[1]??-1)-(a[1]??-1))
      .map(([p,v])=>`<div class="r"><span><span class="dot" style="--c:${COL[p]}"></span>${SHORT[p]}</span><span class="mono">${v==null?"–":(mode==="raw"?v:f1(v))}</span></div>`).join("");
    tip.innerHTML=`<b>${fmtDW(D.days[i])}</b>${rowsH}`; tip.hidden=false;
    const px=x(i)*r.width/W; const tw=tip.offsetWidth;
    tip.style.left=(px+12+tw>r.width? px-12-tw : px+12)+"px"; tip.style.top="8px";
  };
  svg.addEventListener("pointermove",move); svg.addEventListener("pointerdown",move);
  svg.addEventListener("pointerleave",()=>{tip.hidden=true; xh.setAttribute("opacity",0);});
}
